# Copy this file to .env before running docker compose.
# PostgreSQL settings initialize a new volume; existing volumes keep their current credentials.
POSTGRES_DB=chat_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/${POSTGRES_DB}
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_SECONDS=3600
